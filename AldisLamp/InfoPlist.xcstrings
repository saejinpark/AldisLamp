    "NSCameraUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방 램프의 빛 신호를 읽어 모스 부호를 해독하기 위해 카메라를 사용합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera reads the other lamp's light signals to decode Morse code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手のランプの光信号を読み取ってモールス符号を解読するためにカメラを使用します。"
          }
        }
      }
    }
  }
